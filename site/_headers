# Images keep their filenames when replaced (new photos go in under the same
# names), so they must never be cached as "immutable" for a year. One day is
# a safe balance. Only ONE rule may set Cache-Control for any file: Netlify
# merges every rule that matches a path, so two would stack into one header.
/*.webp
  Cache-Control: public, max-age=86400, must-revalidate
/*.png
  Cache-Control: public, max-age=86400, must-revalidate
/*.jpg
  Cache-Control: public, max-age=86400, must-revalidate
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
# Post images and videos are staged in /social/ only long enough for Instagram,
# Facebook and Google to copy them, then deleted. Never let search engines index them.
/social/*
  X-Robots-Tag: noindex, nofollow, noimageindex
# Private hand-off page for sending client texts from Messages. Never index it.
/text/*
  X-Robots-Tag: noindex, nofollow
