# Images keep their filenames when replaced (new photos go in under the same
# names), so they must never be cached as "immutable" for a year. One day is
# a safe balance. Only ONE rule may set Cache-Control for any file: Netlify
# merges every rule that matches a path, so two would stack into one header.
/*.webp
  Cache-Control: public, max-age=86400, must-revalidate
/*.png
  Cache-Control: public, max-age=86400, must-revalidate
/*.jpg
  Cache-Control: public, max-age=86400, must-revalidate
# The service worker must never be held in cache, or a fix to it would sit
# unused on returning phones. Netlify's default already does this; saying it
# here means a later change to the rules above cannot quietly break it.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
# Font files never change under the same name (a new version gets a new
# filename), so browsers may keep them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
# Post images and videos are staged in /social/ only long enough for Instagram,
# Facebook and Google to copy them, then deleted. Never let search engines index them.
/social/*
  X-Robots-Tag: noindex, nofollow, noimageindex
# Private hand-off page for sending client texts from Messages. Never index it.
/text/*
  X-Robots-Tag: noindex, nofollow

# Booking page for the Square cutover. Live bookings still go through Booksy, so
# this page is not linked and must not be indexed until the swap.
/book.html
  X-Robots-Tag: noindex, nofollow
